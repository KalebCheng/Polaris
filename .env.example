# ── 镜像 ─────────────────────────────────────────────────────
# 必须与 Docker Hub 上实际仓库一致；仓库需提前创建。
POLARIS_IMAGE=kalebcheng/polaris:latest
POLARIS_HTTP_PORT=8100

# ── PostgreSQL ───────────────────────────────────────────────
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=replace-with-strong-password
POLARIS_DB_NAME=polaris
POLARIS_DB_SSLMODE=disable
POLARIS_DB_PUBLISHED_PORT=5432

# 启动时自动迁移 / 写入种子数据
# 首次安装需 seed=true；创建内置组织与管理员后可改为 false
POLARIS_DB_AUTO_MIGRATE=true
POLARIS_DB_SEED=true

# ── Redis ────────────────────────────────────────────────────
POLARIS_REDIS_PASSWORD=replace-with-strong-password
POLARIS_REDIS_PUBLISHED_PORT=6379

# ── 必需密钥 ─────────────────────────────────────────────────
# 生成方式：openssl rand -base64 48
POLARIS_JWT_SECRET=replace-with-random-jwt-secret
# 必须是 base64 编码的 32 字节：openssl rand -base64 32
# 丢失后已加密的提供商密钥 / TOTP 密钥将无法解密，请务必备份。
POLARIS_CREDENTIAL_ENC_KEY=replace-with-base64-32-bytes

# ── 对外地址与浏览器安全 ─────────────────────────────────────
POLARIS_ISSUER=http://localhost:8100
POLARIS_CSRF_ALLOWED_ORIGINS=http://localhost:8100
POLARIS_COOKIE_SECURE=false

# ── 种子管理员 ───────────────────────────────────────────────
POLARIS_ADMIN_PASSWORD=replace-with-strong-admin-password
